<?xml version="1.0" encoding="utf-8"?>
<!-- 原版资产库声明（<library> 一行一库）。由 agent 增删；Project.xml 通过
     <include path="libraries.xml"/> 合并本文件，Project.xml 本身仍由人管。
     必须放仓库根目录：lime 会把 include 文件所在目录加为 source 路径，
     根目录文件的目录为空、被跳过。
     path 指向 assets/legacy/ 下（scripts/sync-legacy-assets.sh 按
     assets/legacy-assets.txt 同步生成）：本文件和 legacy-assets.txt 必须
     同 commit 改——library 指向的文件不存在时构建直接红。
     id 即库名：Assets.getMovieClip("<id>:符号名")；空符号名取整条时间轴。
     id 全局唯一，用 swf 文件名去 .swf 后的原名。 -->
<project>

    <!-- V1 探路样本（issue #1） -->
    <library path="assets/legacy/source/core/module/ui/allcrops/Crop_1056_3.swf" id="Crop_1056_3" preload="true" />
    <library path="assets/legacy/source/core/module/mc/farm/aswf/a6291_1.swf" id="a6291_1" preload="true" />
    <library path="assets/legacy/source/core/module/ui/shop_v_7.swf" id="shop_v_7" preload="true" />
    <library path="assets/legacy/source/core/module/ui/dogs/FDog100_v_1.swf" id="FDog100_v_1" preload="true" />

    <!-- V2 加载链路（issue #3）：预加载器 FarmLite.boot/startLiteUI 按相对
         module/… URL 拉的库（LocalSwfLoader 按 URL 尾段映射库名）。不 preload：
         原版这些是运行期网络加载，链路走 CmdLoadFile→LoadManager。 -->
    <library path="assets/legacy/source/core/module/ui/lite_ui_v_0.swf" id="lite_ui_v_0" />
    <library path="assets/legacy/source/core/module/main3_v_221.swf" id="main3_v_221" />
    <library path="assets/legacy/source/core/module/ui/main/farmui_full_v_40.swf" id="farmui_full_v_40" />
    <library path="assets/legacy/source/core/module/ui/main/farmui2_v_58.swf" id="farmui2_v_58" />
    <library path="assets/legacy/source/core/module/ui/water_ui_v_0.swf" id="water_ui_v_0" />
    <!-- FarmLiteView 背景图（FarmLiteModel.get_background：默认
         module/ui/farm/diy/1.swf；快照 uid=1 的 decorative items["1"].itemId
         也是 1，user_run.php 输出同一 URL） -->
    <library path="assets/legacy/source/core/module/ui/farm/diy/1.swf" id="1" />

    <!-- V3a 启动链（issue #7）：FarmApplication.startup 的 500/1400ms setTimeout
         自动派发 MSG_LOAD_WATER/CARDSGAME/FREEGIFT/QUICKSHOOT →
         Module.onLoadModuleFile → RSLManager.requestFile（nc_main moduleList 的
         url）。不 preload：原版为运行期网络加载，与 assets/legacy-assets.txt
         同 commit 增删 -->
    <library path="assets/legacy/source/core/module/ui/pool_v_13.swf" id="pool_v_13" />
    <library path="assets/legacy/source/core/module/ui/quickshoot_v_0.swf" id="quickshoot_v_0" />
    <library path="assets/legacy/source/core/module/ui/cards_v_1.swf" id="cards_v_1" />
    <library path="assets/legacy/source/core/module/ui/gifts_v_11.swf" id="gifts_v_11" />
    <!-- nc_addon.php:81 beastLoaderUrl：Main.loadWildShell（:188-190 无条件，
         不受 _beast 门控）与 FarmApplication.loadWildShell（:766-771）都会在
         启动窗口请求。与 assets/legacy-assets.txt 同 commit 增删 -->
    <library path="assets/legacy/source/core/module/mc/farm/wild/WildShellNc_v_5.swf" id="WildShellNc_v_5" />

</project>
