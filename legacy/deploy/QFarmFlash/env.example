# ===== QFarmFlash Docker 环境配置 =====
# 用法：cp env.example .env 然后修改（.env 已被 .gitignore 忽略，不会入库）
# 注：仓库不收录 .env* 文件，本模板命名为 env.example

# MySQL root 密码（必改；浏览器安装向导 step2 填的 dbpw 必须与这里一致）
MYSQL_ROOT_PASSWORD=change_me

# 对外端口（默认 8089）
PORT=8089

# 端口绑定地址：默认 0.0.0.0（所有网卡，局域网可直接访问）。
# 仅本机访问改为 127.0.0.1；也可填单个内网 IP（如 192.168.1.100）。
# 警告：打上 qf_checkauth uid=1 兜底补丁后，任何能访问端口的人都以管理员
# 身份操作农场——0.0.0.0 仅适合可信内网，绝不可暴露到公网。
BIND_IP=0.0.0.0
