<?xml version="1.0" encoding="utf-8"?>
<!-- OpenFL 工程描述。由人管（受保护路径）：agent 需要新增 <library>/<assets> 声明时
     在 PR 说明里列出或 BLOCKED，不自己改。
     舞台尺寸 860x500、背景白色来自反编译 header（happyfarm3/mcloader 舞台），帧率 24。 -->
<project>

    <meta title="openfl-farm" package="com.qfarm.openflfarm" version="0.1.0" />

    <app main="Main" file="OpenflFarm" path="export" />

    <window width="860" height="500" if="html5" background="#FFFFFF" fps="24" />
    <window width="860" height="500" unless="html5" background="#FFFFFF" fps="24"
            orientation="landscape" resizable="false" />

    <source path="src" />

    <haxelib name="openfl" />
    <haxelib name="swf" />

    <!-- 原版资产 swf：assets/legacy/ 由 scripts/sync-legacy-assets.sh 按
         assets/legacy-assets.txt 从 legacy/deploy/ 同步，两个文件必须同 commit 改
         （library 指向的文件不存在时 lime 构建直接红）。
         id 即库名：Assets.getMovieClip("<id>:符号名")，空符号名取整个时间轴
         （swf 库 README 写法）。V1 四样本（issue #1）： -->
    <library path="assets/legacy/source/core/module/ui/allcrops/Crop_1056_3.swf" id="Crop_1056_3" preload="true" />
    <library path="assets/legacy/source/core/module/mc/farm/aswf/a6291_1.swf" id="a6291_1" preload="true" />
    <library path="assets/legacy/source/core/module/ui/shop_v_7.swf" id="shop_v_7" preload="true" />
    <library path="assets/legacy/source/core/module/ui/dogs/FDog100_v_1.swf" id="FDog100_v_1" preload="true" />

</project>
